    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "description": "RNF-01: Tiempo promedio de autenticación (login + verify-token). Meta: ≤ 60 segundos.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "drawStyle": "line", "fillOpacity": 10, "thresholdsStyle": { "mode": "line+area" } },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 60 } ] },
          "unit": "s"
        }
      },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "id": 1,
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "expr": "avg(rate(http_server_requests_seconds_sum{job=~\".*insumos.*\", uri=~\".*login.*|.*verify-token.*\"}[5m]) / rate(http_server_requests_seconds_count{job=~\".*insumos.*\", uri=~\".*login.*|.*verify-token.*\"}[5m]))",
          "legendFormat": "Tiempo promedio autenticación",
          "refId": "A"
        }
      ],
      "title": "RNF-01: Tiempo de autenticación (meta ≤ 60s)",
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
