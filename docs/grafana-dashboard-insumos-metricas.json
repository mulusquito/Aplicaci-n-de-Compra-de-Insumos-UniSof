          "expr": "100 * sum(rate(http_server_requests_seconds_count{job=~\".*insumos.*\", status=\"200\", uri=~\".*verify-token.*\"}[10m])) / sum(rate(http_server_requests_seconds_count{job=~\".*insumos.*\", uri=~\".*verify-token.*\"}[10m]))",
