spring.application.name=insumos

# Sesión servidor: debe cubrir inactividad máxima del cliente (p. ej. 4 min sin ping) + margen. El front renueva con /api/auth/me al usar la app.
server.servlet.session.timeout=420s

spring.datasource.url=jdbc:postgresql://localhost:5432/unisof_db
spring.datasource.username=postgres
spring.datasource.password=TU_PASSWORD_POSTGRES
spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=true

app.admin.email=tu-correo@ejemplo.com

# SCRUM-35: SMTP - Copiar application.properties.example a application.properties
app.mail.enabled=true
spring.mail.host=smtp.gmail.com
spring.mail.port=465
spring.mail.username=tu-correo@gmail.com
spring.mail.password=TU_CONTRASENA_APLICACION
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.ssl.enable=true
spring.mail.properties.mail.smtp.starttls.enable=false

# URL base de la app (para redirección tras el pago)
# Local: http://localhost:8080 | Producción: usa APP_BASE_URL
app.base-url=http://localhost:8080

# Mercado Pago - Access Token (opcional si usas Stripe)
mercadopago.access-token=${MERCADOPAGO_ACCESS_TOKEN:}

# Pasarela de pago: "mercadopago" o "stripe"
# IMPORTANTE: Para pagos con Stripe necesitas STRIPE_SECRET_KEY
app.payment-provider=stripe

# Stripe - Clave secreta. OBLIGATORIO para pagos.
# Local: usa run-local.ps1 o define SPRING_MAIL_PASSWORD y STRIPE_SECRET_KEY como variables de entorno
stripe.secret-key=${STRIPE_SECRET_KEY:}

# Chat Nova: OPENAI_API_KEY en variables de entorno al iniciar la app
# app.openai.api-key=${OPENAI_API_KEY:}
